#!/sbin/sh
# KernelSU / Magisk compatible module installer.
#
# Both KernelSU and Magisk invoke this script during zip install.
# Module is laid out into $MODPATH (= /data/adb/modules/<id>) and module.prop
# must already exist there (created from the zip by the caller for Magisk,
# or by ksud for KernelSU). customize.sh does the actual file work.

set -e
ui_print() { echo "$1"; }

OUTFD=$2
ZIPFILE=$3

# $MODPATH and $MODID are provided by the host (ksud or Magisk).
# If running standalone (manual invoke), fall back to defaults.
[ -n "$MODPATH" ] || MODPATH=/data/adb/modules/fixchinacarrier-ksu
[ -n "$MODID"  ] || MODID=fixchinacarrier-ksu

mkdir -p "$MODPATH"

# Detect host (KSU sets KSU=true env; Magisk sets MAGISK_VER_CODE).
if [ "$KSU" = "true" ]; then
  ui_print "- Installing via KernelSU"
elif [ -n "$MAGISK_VER_CODE" ]; then
  ui_print "- Installing via Magisk"
else
  ui_print "!! Unknown root framework (neither KSU nor Magisk detected)."
  ui_print "   Aborting."
  exit 1
fi

# Run module customization if present.
if [ -f "$MODPATH/customize.sh" ]; then
  ui_print "- Running customize.sh"
  # shellcheck disable=SC1091
  . "$MODPATH/customize.sh"
else
  ui_print "!! customize.sh not found in $MODPATH"
  exit 1
fi

ui_print "- Done"
exit 0
