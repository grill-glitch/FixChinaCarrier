#!/sbin/sh
# Magisk installer entry point.
#
# !!! KernelSU NEVER RUNS THIS FILE !!!
#
# Verified in ksud source (KernelSU-Next userspace/ksud/src/module.rs ->
# exec_install_script -> metamodule::get_install_script): the install script is
# always either KSU's own built-in installer.sh (INSTALLER_CONTENT) or the
# active metamodule's metainstall.sh. The zip's META-INF/com/google/android/
# update-binary is never read. KSU extracts the zip into $MODPATH and sources
# customize.sh itself.
#
# So this file exists purely for Magisk, and it must do the standard Magisk
# dance: load util_functions.sh and call install_module(). install_module()
# extracts the zip, sets MODPATH, sources customize.sh, then cleans up.
#
# Do not use `set -e` here either - install_module() is Magisk's own code and
# the module must not change the installer's shell behaviour.

umask 022

ui_print() { echo "$1"; }

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

MAGISK_UTIL=/data/adb/magisk/util_functions.sh
if [ ! -f "$MAGISK_UTIL" ]; then
  ui_print "

***************************"
  ui_print " Please install Magisk v20.4+! "
  ui_print "

***************************"
  exit 1
fi

# shellcheck disable=SC1090
. "$MAGISK_UTIL"

if [ "${MAGISK_VER_CODE:-0}" -lt 20400 ]; then
  ui_print "! Magisk v20.4 or newer is required."
  exit 1
fi

# Extracts the zip into $MODPATH, sources customize.sh, then cleans up.
install_module
exit 0
